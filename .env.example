# Clerk Authentication (https://clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Server-side only (set in Vercel Environment Variables)
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# DATABASE_URL est injectée automatiquement par Vercel quand tu connectes une
# base Postgres (Storage > Marketplace > Neon) à ton projet. Inutile de la
# copier ici pour un déploiement Vercel — seulement pour tester en local avec
# `vercel dev` (récupère-la via `vercel env pull`).
# DATABASE_URL=postgres://YOUR_NEON_CONNECTION_STRING
