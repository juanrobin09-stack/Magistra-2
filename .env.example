# ════════════════════════════════════════════════════════════════════════════
# Magistra — variables d'environnement
# ════════════════════════════════════════════════════════════════════════════
# Développement / serveur autonome : copiez ce fichier en « .env » et complétez-le.
# Vercel : renseignez ces variables dans Project Settings → Environment Variables.
#
# Ne committez JAMAIS de vraies valeurs. Seule VITE_CLERK_PUBLISHABLE_KEY est publique :
# toutes les autres variables restent sur le serveur et ne sont jamais envoyées au navigateur.

# ─── Navigateur (seule variable publique) ───────────────────────────────────
# Clé publiable Clerk (pk_test_… ou pk_live_…), intégrée au site lors de « npm run build ».
# Sans elle, l'interface web démarre en mode démonstration (aucune donnée enregistrée).
VITE_CLERK_PUBLISHABLE_KEY=

# ─── Authentification (serveur) ─────────────────────────────────────────────
# Le serveur vérifie le jeton de session Clerk de chaque requête (Authorization: Bearer …)
# et en déduit l'utilisateur ; aucun identifiant envoyé par le navigateur n'est pris en compte.
#
# Clé secrète Clerk (sk_…) : Clerk Dashboard → API keys.
CLERK_SECRET_KEY=
# Facultatif : clé publique PEM (Clerk Dashboard → API keys → « JWT public key »).
# Permet une vérification sans appel réseau. Les retours à la ligne peuvent être écrits « \n ».
CLERK_JWT_KEY=
# Fortement recommandé en production : origines autorisées à émettre des jetons,
# séparées par des virgules (ex. https://magistra.univ-exemple.fr,http://localhost:5173).
CLERK_AUTHORIZED_PARTIES=
# Recommandé : secret de signature du webhook Clerk (whsec_…). Quand un compte est supprimé chez Clerk
# (« Gérer mon compte » ou tableau de bord), Clerk appelle POST /api/clerk-webhook (évènement
# « user.deleted ») et Magistra efface l'historique, le profil et les traces anti-abus de ce compte.
# Clerk Dashboard → Webhooks → Add Endpoint : URL https://<votre-domaine>/api/clerk-webhook,
# évènement « user.deleted », puis copiez le « Signing Secret ».
# Sur Vercel, ajoutez aussi NODEJS_HELPERS=0 : la signature porte sur le corps brut de la requête.
CLERK_WEBHOOK_SECRET=

# ─── Base de données Supabase (serveur) ─────────────────────────────────────
# Exécutez d'abord supabase-schema.sql dans Supabase → SQL Editor (script réexécutable).
SUPABASE_URL=
# Clé service_role (ou clé secrète « sb_secret_… ») : SERVEUR UNIQUEMENT.
# Ne la préfixez jamais par VITE_ : elle serait exposée à tous les visiteurs.
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : « memory » pour des essais sans base (historique perdu au redémarrage).
# En développement (npm run dev), la mémoire est utilisée automatiquement si Supabase n'est pas configuré.
MAGISTRA_STORE=

# ─── Serveur d'IA (serveur) ─────────────────────────────────────────────────
# Aucune API commerciale n'est imposée : tout serveur compatible OpenAI (vLLM, llama.cpp,
# LM Studio, LocalAI, passerelle universitaire…) ou un serveur Ollama convient.
#
# « openai-compatible » (par défaut) ou « ollama ».
AI_PROVIDER=openai-compatible
# Adresse du serveur, /v1 inclus pour un serveur compatible OpenAI (ex. https://ia.univ-exemple.fr/v1).
# Pour Ollama : ex. http://127.0.0.1:11434 (valeur par défaut).
AI_BASE_URL=
# Nom exact du modèle servi (ex. mistralai/Mistral-Small-3.2-24B-Instruct-2506).
AI_MODEL=
# Facultatif : clé d'accès au serveur d'IA. Jamais envoyée au navigateur ni affichée par /api/status.
AI_API_KEY=
# Nom affiché aux enseignants (défaut : « Serveur d'IA »), ex. « Serveur universitaire ».
AI_SERVER_LABEL=
# Taille de contexte du modèle en tokens (défaut : 32768). Détermine la quantité d'extraits
# de documents acceptée.
AI_CONTEXT_TOKENS=32768
# Longueur maximale d'un contenu produit, en tokens (défaut : 6000).
AI_MAX_OUTPUT_TOKENS=6000
# Durée maximale d'une génération complète, en secondes (défaut : 280, sous la limite
# de 300 s configurée pour api/generate.ts dans vercel.json).
AI_TIMEOUT_SECONDS=280
# Délai du test de disponibilité du serveur d'IA affiché dans l'interface, en ms (défaut : 4000).
AI_HEALTH_TIMEOUT_MS=4000

# ─── Recherche de sources (serveur) ─────────────────────────────────────────
# Publications académiques (HAL, Crossref) : true par défaut.
RESEARCH_ACADEMIC=true
# Wikipédia en français : true par défaut.
RESEARCH_WIKIPEDIA=true
# Facultatif : instance SearXNG pour la recherche web et les sources institutionnelles
# (Éduscol, Bulletin officiel), ex. https://searxng.univ-exemple.fr (format JSON activé).
SEARXNG_URL=
# Facultatif : adresse de contact transmise à Crossref (accès prioritaire « polite pool »).
CROSSREF_MAILTO=
# Délai maximal de chaque requête de recherche, en ms (défaut : 8000).
RESEARCH_TIMEOUT_MS=8000

# ─── Protection technique (serveur) ─────────────────────────────────────────
# Aucune limite d'utilisation n'est imposée aux enseignants. Seules les rafales anormales
# sont freinées : nombre maximal de demandes de génération par minute et par utilisateur
# (défaut : 10 ; 0 = désactivé).
RATE_LIMIT_PER_MINUTE=10
# Plafond de demandes de génération par minute pour TOUT le déploiement, tous utilisateurs confondus
# (défaut : 120 ; 0 = désactivé). Protège le serveur d'IA d'un afflux (par exemple de nombreux comptes
# créés en rafale). Au-delà : « Le serveur d'IA est surchargé. Réessayez dans quelques instants. »
RATE_LIMIT_GLOBAL_PER_MINUTE=120
# Générations en cours en même temps pour un même utilisateur, toutes instances du serveur
# confondues (défaut : 2 ; 0 = pas de limite ; 100 au plus). Au-delà, la demande est refusée
# (« Une génération est déjà en cours ») jusqu'à la fin ou l'arrêt d'une génération.
MAX_CONCURRENT_GENERATIONS_PER_USER=2
# Générations en cours en même temps sur une instance du serveur, tous utilisateurs confondus,
# pour ne pas saturer le serveur d'IA (défaut : 8 ; 0 = pas de limite ; 1000 au plus).
# Au-delà : « Le serveur d'IA est surchargé. Réessayez dans quelques instants. »
MAX_CONCURRENT_GENERATIONS=8
# Fuseau horaire utilisé pour les statistiques quand le navigateur n'en indique pas (défaut : Europe/Paris).
DEFAULT_TIMEZONE=Europe/Paris

# ─── Serveur Node autonome (npm run build && npm run build:server && npm start) ─
# Port d'écoute (défaut : 3000) et adresse (défaut : toutes les interfaces).
PORT=3000
HOST=
# Dossier de l'application construite (défaut : dist/ à côté de dist-server/).
MAGISTRA_STATIC_DIR=
# Fichier de configuration lu au démarrage (défaut : .env du dossier courant).
MAGISTRA_ENV_FILE=
# Origines https supplémentaires autorisées par la politique de sécurité du contenu (CSP),
# séparées par des espaces. OBLIGATOIRE si vous utilisez un domaine Clerk personnalisé
# (ex. https://clerk.univ-exemple.fr) : sinon la connexion est bloquée par le navigateur.
# Sur Vercel, ajoutez ce domaine aux directives script-src, connect-src, img-src et
# frame-src de l'en-tête Content-Security-Policy dans vercel.json.
CSP_EXTRA_ORIGINS=
