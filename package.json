{
  "name": "magistra",
  "productName": "Magistra",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:real-ai": "node scripts/real-ai-check.mjs",
    "preview": "vite preview",
    "build:site": "tsc -b && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts --port 4174 --strictPort --host 127.0.0.1",
    "verify:site": "node scripts/verify-site.mjs",
    "electron:build": "node scripts/build-electron.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "electron:smoke": "npm run build && node scripts/build-electron.mjs && node scripts/electron-smoke.mjs",
    "build:electron": "npm run build && node scripts/build-electron.mjs && electron-builder --win --x64",
    "build:electron:dir": "npm run build && node scripts/build-electron.mjs && electron-builder --dir",
    "build:server": "node scripts/build-server.mjs",
    "ai:check": "node scripts/build-server.mjs --run-ai-check",
    "start": "node dist-server/standalone.js",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/react": "^6.17.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.2"
  },
  "description": "Magistra — assistant pédagogique IA open source pour les enseignants, de la maternelle au doctorat",
  "license": "MIT",
  "author": {
    "name": "Juan Robin",
    "url": "https://github.com/juanrobin09-stack"
  },
  "engines": {
    "node": ">=20.19"
  }
}
