{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-site",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/usage-maintenance.ts": {
      "maxDuration": 15
    },
    "api/usage.ts": {
      "maxDuration": 15
    },
    "api/usage-dashboard.ts": {
      "maxDuration": 15
    },
    "api/windows-release.ts": {
      "maxDuration": 15
    },
    "api/download.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/tableau-prive",
      "destination": "/api/usage-dashboard"
    },
    {
      "source": "/telecharger",
      "destination": "/api/download"
    }
  ],
  "crons": [
    { "path": "/api/usage-maintenance", "schedule": "17 3 * * *" }
  ],
  "headers": [
    {
      "source": "/tableau-prive",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-5I3l7VnOdlMnPZnYUyyiNPKF2YcX1/PpPd/eTbYAR84=' 'sha256-jg3b0sG+Ye4cr9Lq4vJnq8aAFom+4H4Z1N+Y49CvO5M=' 'sha256-xPt4msBDyCr1YChMwG2KBLDk4RBdGUGoP3uDwTOWeko=' 'sha256-OveDNKefcl7niL3JQZqmPmGNDhNSvn2DGfwAYrZTlxg=' 'sha256-5FVRPNixA7BW8zAjGi+F7VLdwcof/+VlbIjGfleuVPU=' 'sha256-YD0rfiLEkk6SEDS0VUqSXX5Y4EgIyNCj3D/YG0iXwac=' 'sha256-Fdf58uHs1I2/e2tUxSnZpwbTS0hYxJ4Uj00fIaGWRJM=' 'sha256-MsQOyADBTo+oC/m34qvTnjeMcMoRIzMSfMMmoGCAa9k=' 'sha256-s3YMLsGNKrVKqRhS6vcCehfnSxkpLBeYz0J4H9J5dTY=' 'sha256-5qSOM+6Yzq4T61c7oFoyXmC/hXqgBLclPIA6JQuKvFs=' 'sha256-abnfSgUp8tkqDD+i8oSvQ2BdMO5R43GcP2/itMU6puY=' 'sha256-02gybtop1lXlaP/F8M9Mam7mvkuH2I5og8UNnRk8CFA=' 'sha256-DTLc8eO3u4ndGNMjzPwsjPkMzGpf747M9lxkwII+Xuw=' 'sha256-b8X1Vvz8x/PpI3HGBf6ncaxdy4ttWiGKIukn3uTskRs='; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/telecharger",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/setup",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/onboarding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/presentation",
      "destination": "/",
      "permanent": true
    }
  ]
}
