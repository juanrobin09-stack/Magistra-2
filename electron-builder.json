{
  "appId": "com.futureai.magistra",
  "productName": "Magistra",
  "copyright": "Copyright © 2026 FutureAI — logiciel libre (licence MIT)",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**",
    "dist/**",
    "package.json",
    "!**/*.map",
    "!node_modules/**"
  ],
  "asar": true,
  "protocols": [
    {
      "name": "Magistra",
      "schemes": [
        "magistra"
      ]
    }
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "enableCookieEncryption": true,
    "grantFileProtocolExtraPrivileges": false
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "electronLanguages": [
    "fr",
    "en-US"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png",
    "artifactName": "Magistra-${version}-win-${arch}.${ext}",
    "legalTrademarks": "Magistra"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "shortcutName": "Magistra",
    "deleteAppDataOnUninstall": false,
    "artifactName": "Magistra-Setup-${version}.${ext}"
  },
  "linux": {
    "target": [
      "dir"
    ],
    "icon": "build/icon.png",
    "category": "Education",
    "executableName": "magistra"
  },
  "mac": {
    "icon": "build/icon.png",
    "category": "public.app-category.education"
  },
  "publish": null
}
